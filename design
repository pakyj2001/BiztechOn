<style>
       :root { --header-h: 80px; --sub: #888; }
       * { margin: 0; padding: 0; box-sizing: border-box; }
       body { font-family: 'Noto Sans KR', sans-serif; background: #fff; color: #111; line-height: 1.5; }
       a { text-decoration: none; color: inherit; transition: 0.3s; }
       /* 고정 헤더 */
       header { width: 100%; height: var(--header-h); display: flex; justify-content: space-between; align-items: center; padding: 0 4%; position: fixed; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); z-index: 1000; border-bottom: 1px solid #f0f0f0; }
       .logo { font-family: 'Montserrat'; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.5px; }
       nav ul { display: flex; list-style: none; gap: 35px; }
       nav ul li a { font-family: 'Montserrat'; font-size: 0.8rem; text-transform: uppercase; color: var(--sub); letter-spacing: 1px; }
       nav ul li a.active { color: #000; font-weight: 700; }
       /* 메인 컨텐츠 영역 */
       main { padding: calc(var(--header-h) + 60px) 4% 100px; max-width: 1400px; margin: 0 auto; }
       h1.page-title { font-family: 'Montserrat'; font-size: 3rem; margin-bottom: 60px; font-weight: 700; letter-spacing: -1px; }
       /* 3x3 디자인 그리드 */
       .design-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 50px 30px; }
       .design-item { cursor: pointer; }
       /* 이미지 박스 (세로형 3:4 비율) */
       .img-wrap { width: 100%; aspect-ratio: 3 / 4; overflow: hidden; background: #f7f7f7; }
       .img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: 0.8s cubic-bezier(0.165, 0.84, 0.44, 1); }
       .design-item:hover img { transform: scale(1.08); }
       .d-info { margin-top: 20px; }
       .d-info span { font-family: 'Montserrat'; font-size: 0.65rem; color: var(--sub); text-transform: uppercase; letter-spacing: 2px; }
       .d-info h3 { font-family: 'Montserrat'; font-size: 1.05rem; font-weight: 700; margin: 6px 0 8px; }
       .d-info p { font-size: 0.85rem; color: #777; line-height: 1.6; font-weight: 300; word-break: keep-all; }
       /* 이미지 라이트박스 (클릭 시 크게 보기) */
       .img-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.98); z-index: 2000; justify-content: center; align-items: center; cursor: zoom-out; }
       .img-modal img { max-width: 90%; max-height: 85vh; object-fit: contain; box-shadow: 0 20px 50px rgba(0,0,0,0.1); animation: fadeIn 0.4s ease; }
       .close-modal { position: absolute; top: 30px; right: 40px; color: #111; font-size: 40px; cursor: pointer; }
       @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
       /* 푸터 */
       footer { padding: 60px 4%; text-align: center; border-top: 1px solid #eee; font-family: 'Montserrat'; font-size: 0.7rem; color: #ccc; letter-spacing: 1px; }
       /* 반응형 설정 */
       @media (max-width: 1024px) { .design-grid { grid-template-columns: repeat(2, 1fr); } }
       @media (max-width: 650px) { .design-grid { grid-template-columns: 1fr; } .page-title { font-size: 2.2rem; } }
</style>
</head>
